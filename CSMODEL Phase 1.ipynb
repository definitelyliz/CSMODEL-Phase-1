    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "pd.set_option('display.float_format', lambda x: '%.2f' % x)\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "\n",
    "# Read csv and get the number of columns and rows\n",
    "newDf = pd.read_csv(\"filtered_file_2.csv\")\n",
    "\n",
    "# Group by region and sum the expenditures\n",
    "expenditure_summary = newDf.groupby('W_REGN').sum()\n",
    "\n",
    "# Calculate the total expenditure for home and outside\n",
    "totalHomeExpenditure = expenditure_summary['T_FOOD_HOME']\n",
    "totalOutsideExpenditure = expenditure_summary['T_FOOD_OUTSIDE']\n",
    "\n",
    "# Compare the expenditures\n",
    "data = {\n",
    "    'T_FOOD_HOME': totalHomeExpenditure,\n",
    "    'T_FOOD_OUTSIDE': totalOutsideExpenditure\n",
    "}\n",
    "\n",
    "comparison = pd.DataFrame(data)\n",
    "average = comparison['T_FOOD_HOME'].sum() / 40171\n",
    "\n",
    "tFoodHomeMCTAndMD = comparison.agg({'T_FOOD_HOME': ['mean', 'median', 'std', 'var']})\n",
    "tFoodOutsideMCTAndMD = comparison.agg({'T_FOOD_OUTSIDE': ['mean', 'median', 'std', 'var']})\n",
    "print(\"Total Food Expenditure at Home measures of central tendency and measures of dispersion :\\n\\n\",\n",
    "    tFoodHomeMCTAndMD)\n",
    "print(\"\\nTotal Food Expenditure Outside measures of central tendency and measures of dispersion :\\n\\n\",\n",
    "    tFoodOutsideMCTAndMD)\n",
    "\n",
    "correlation = totalHomeExpenditure.corr(totalOutsideExpenditure)\n",
    "\n",
    "print(\"\\nCorrelation value = \", correlation.round(2))\n",
    "\n",
    "print(\"\\nThis figure shows a bar graph between the amount of food consumed at home and the amount of food consumed\\n outside across different regions: \")\n",
    "\n",
    "# Plotting the expenditures\n",
    "plt.figure(figsize=(8, 4))\n",
    "comparison.plot(kind='bar')\n",
    "plt.title('Total Food Expenditure Comparison by Region')\n",
    "plt.xlabel('W_REGN')\n",
    "plt.ylabel('Total Expenditure')\n",
    "plt.legend(['T_FOOD_HOME', 'T_FOOD_OUTSIDE'])\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nThis histogram shows the distribution of the total food consumed at home and the total food consumed outside: \")\n",
    "\n",
    "# Plotting the distributions\n",
    "totalHomeExpenditure.hist(bins=30, label='T_FOOD_HOME', figsize=(30, 15))\n",
    "totalOutsideExpenditure.hist(bins=30, label='T_FOOD_OUTSIDE', figsize=(30, 15))\n",
    "plt.title('Distribution of Food Expenditures')\n",
    "plt.xlabel('Expenditure')\n",
    "plt.legend()\n",
    "plt.show()\n",
