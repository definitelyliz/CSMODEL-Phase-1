    "newDf = pd.read_csv(\"filtered_file.csv\")\n",
    "\n",
    "# Add average values to empty rows\n",
    "def cleanDataType(size, columnName, average):\n",
    "    for i in range(size):\n",
    "        if(newDf[columnName][i] == \"  \"):\n",
    "            newDf.loc[i, columnName] = average\n",
    "        newDf.loc[i, columnName] = int(newDf.loc[i, columnName])\n",
    "\n",
    "cleanDataType(newDf['EMPLOYED_PAY'].size, 'EMPLOYED_PAY', employedPayAve)\n",
    "cleanDataType(newDf['EMPLOYED_PROF'].size, 'EMPLOYED_PROF', employedProfAve)\n",
    "\n",
    "# Select columns\n",
    "selected_columns = newDf[['W_REGN', 'FSIZE', 'TOINC', 'T_BREAD', 'T_MEAT', 'T_FISH', 'T_MILK', 'T_OIL', 'T_FRUIT', \n",
    "                        'T_VEG', 'T_SUGAR', 'T_FOOD_NEC', 'T_COFFEE', 'T_MINERAL', 'T_ALCOHOL', 'T_TOBACCO', \n",
    "                        'T_OTHER_VEG', 'T_FOOD_HOME', 'T_FOOD_OUTSIDE', 'T_FOOD', 'HHTYPE', 'EMPLOYED_PAY', \n",
    "                        'EMPLOYED_PROF']]\n",
    "\n",
    "# Convert to csv\n",
    "selected_columns.to_csv('filtered_file_2.csv', index=False)"
   ]
