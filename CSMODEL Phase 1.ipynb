    "newDf = pd.read_csv(\"filtered_file.csv\")\n",
    "\n",
    "# Compute for average and set data type to integer\n",
    "def average(size, columnName):\n",
    "    blankCounter = 0\n",
    "    ave = 0\n",
    "    for i in range(size):\n",
    "        if(newDf[columnName][i] == \"  \"):\n",
    "            blankCounter += 1\n",
    "        else:\n",
    "            newDf.loc[i, columnName] = int(newDf.loc[i, columnName])\n",
    "            ave = ((ave * (i - blankCounter)) + (newDf.loc[i, columnName])) / (i + 1 - blankCounter)\n",
    "    return int(round(ave))\n",
    "\n",
    "employedPayAve = average(newDf['EMPLOYED_PAY'].size, 'EMPLOYED_PAY')\n",
    "employedProfAve = average(newDf['EMPLOYED_PROF'].size, 'EMPLOYED_PROF')\n",
    "\n",
    "# Print each average\n",
    "print(employedPayAve)\n",
    "print(employedProfAve)"
   ]
  },
